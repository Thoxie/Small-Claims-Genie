# Small Claims Genie — portable environment template
#
# Copy this file to .env for Docker Compose or configure equivalent secrets in
# your host. Every value below is a placeholder. Do not commit .env.
#
# Required values are marked REQUIRED. Values labelled "Replit runtime only"
# document code paths that need replacement before the application can be fully
# hosted outside Replit; see PORTABILITY.md.

# ── Runtime and routing ──────────────────────────────────────────────────────
# REQUIRED for the API. Use production outside local development.
NODE_ENV=production
# REQUIRED for the API's environment switch. Use production for a hosted app.
APP_ENV=production
# REQUIRED for the API listener. Docker Compose uses 8080 internally.
PORT=8080
# Optional API port used by local Vite proxying; defaults to 18080 in the web app.
API_PORT=8080
# Optional absolute API URL used by scripts or non-proxied clients.
API_BASE_URL=https://api.example.com
# Required only when serving a Vite artifact at a subpath; use / for Docker.
BASE_PATH=/
# Optional Pino logging level (debug, info, warn, error); defaults to info.
LOG_LEVEL=info
# Required in containers when Chromium is installed outside Playwright's cache.
CHROMIUM_PATH=/usr/bin/chromium

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# REQUIRED. Obtain from your PostgreSQL host. Use sslmode=require for managed
# PostgreSQL providers that require TLS; Docker Compose uses sslmode=disable.
DATABASE_URL=postgresql://app_user:replace_me@db.example.com:5432/small_claims_genie?sslmode=require

# ── Clerk authentication ─────────────────────────────────────────────────────
# REQUIRED for API JWT verification. Obtain from the Clerk dashboard.
CLERK_SECRET_KEY=replace_with_clerk_secret_key
# REQUIRED for development/staging if it uses a separate Clerk tenant.
CLERK_SECRET_KEY_DEV=replace_with_development_clerk_secret_key
# REQUIRED when building the web client. Obtain from the Clerk dashboard.
VITE_CLERK_PUBLISHABLE_KEY=replace_with_clerk_publishable_key
# Optional development/staging web-client key for a separate Clerk tenant.
VITE_CLERK_PUBLISHABLE_KEY_DEV=replace_with_development_clerk_publishable_key
# REQUIRED for Expo builds that use Clerk. Set to the same publishable key for
# the selected environment unless mobile uses a separate Clerk app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_with_clerk_publishable_key

# ── OpenAI / AI integration ──────────────────────────────────────────────────
# REQUIRED by the current shared AI client. Outside Replit, point this directly
# at OpenAI's compatible endpoint and use your own OpenAI project API key.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=replace_with_openai_api_key

# ── Stripe ───────────────────────────────────────────────────────────────────
# REQUIRED for purchases, checkout, and the Stripe synchronization layer.
# Obtain from the Stripe Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=replace_with_stripe_publishable_key
# REQUIRED for verified Stripe webhook delivery. Obtain from the webhook endpoint.
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_signing_secret

# ── Email ────────────────────────────────────────────────────────────────────
# REQUIRED for reminder emails. Obtain from the Resend dashboard.
RESEND_API_KEY=replace_with_resend_api_key
# REQUIRED sender identity; verify the domain in Resend first.
RESEND_FROM_EMAIL=Small Claims Genie <notices@example.com>

# ── Owner/admin access ───────────────────────────────────────────────────────
# REQUIRED to protect the separate admin dashboard. Generate a high-entropy
# value; do not reuse an end-user password.
ADMIN_API_KEY=replace_with_a_long_random_admin_key
# REQUIRED owner email accepted by the admin login flow.
ADMIN_EMAIL=owner@example.com
# Legacy/session secret retained for deployments or integrations that expect it.
SESSION_SECRET=replace_with_a_long_random_session_secret

# ── Google Cloud Storage / Replit object storage ─────────────────────────────
# Current code expects Replit object-storage path conventions. These are
# required by the document upload/read paths but are NOT enough outside Replit:
# the sidecar-based credential and signing code must be replaced first.
PRIVATE_OBJECT_DIR=/replace-with-bucket/private
PUBLIC_OBJECT_SEARCH_PATHS=/replace-with-bucket/public

# ── Tyler e-filing/court sync ────────────────────────────────────────────────
# Required only when enabling the Tyler EFM integration. Obtain from Tyler.
TYLER_EFM_TX_BASE_URL=https://tyler-texas.example.com
TYLER_EFM_IL_BASE_URL=https://tyler-illinois.example.com
TYLER_EFM_USERNAME=replace_with_tyler_username
TYLER_EFM_PASSWORD=replace_with_tyler_password
TYLER_EFM_CERT_KEY=replace_with_path_or_pem_reference
TYLER_EFM_CERT_PEM=replace_with_client_certificate_pem
TYLER_EFM_WEBHOOK_SECRET=replace_with_tyler_webhook_secret

# ── Mobile client configuration ──────────────────────────────────────────────
# Required for an Expo build outside Replit.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_APP_ENV=production
# Optional public web domain used by mobile deep links.
EXPO_PUBLIC_DOMAIN=app.example.com

# ── Replit runtime only — do not set on another host ─────────────────────────
# These are documented because current code reads them for Replit fallbacks.
# PORTABILITY.md explains the replacements required outside Replit.
# REPL_ID=
# REPL_IDENTITY=
# REPLIT_CONNECTORS_HOSTNAME=
# REPLIT_DEPLOYMENT=
# REPLIT_DEV_DOMAIN=
# REPLIT_DOMAINS=
# REPLIT_INTERNAL_APP_DOMAIN=
# REPLIT_PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# WEB_REPL_RENEWAL=

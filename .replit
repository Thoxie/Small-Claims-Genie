[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0", "resend:1.0.0", "stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
VITE_CLERK_PUBLISHABLE_KEY_DEV = "pk_test_d2lzZS1tYXJsaW4tNTAuY2xlcmsuYWNjb3VudHMuZGV2JA"
APP_ENV = "staging"
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY = "pk_test_d2lzZS1tYXJsaW4tNTAuY2xlcmsuYWNjb3VudHMuZGV2JA"
EXPO_PUBLIC_APP_ENV = "staging"

[userenv.production]
APP_ENV = "production"
EXPO_PUBLIC_APP_ENV = "production"

[userenv.shared]
ADMIN_API_KEY = "SCGadmin2026"
ADMIN_EMAIL = "paul@thoxie.com"

[objectStorage]
defaultBucketID = "replit-objstore-fbe13e76-2c09-46f1-9698-68ef867b76ca"

[[ports]]
localPort = 18115
externalPort = 80
